# .env.example — copy to .env and fill in (never commit .env)

AUTH_PORT=3200
AUTH_BIND=127.0.0.1

# Shared cookie secret — MUST be the exact same value in authhub/.env,
# boldtick/.env, and tradeforge/.env. Generate once with:
#   openssl rand -hex 32
AUTH_COOKIE_SECRET=
AUTH_COOKIE_DOMAIN=.ishansahoo.com
AUTH_SESSION_DAYS=7

# Your own login — this account is auto-created/re-synced on every restart,
# so rotating your password is just: edit this, restart the service.
AUTH_OWNER_USER=
AUTH_OWNER_PASSWORD=

# Where user data (accounts, reset tokens, favorite links) is stored.
# AUTH_DATA_DIR=./data

# ── Built-in site links shown on the hub page ───────────────────────────────
# Everyone (owner + viewers) sees these four. Defaults shown are used if unset.
# HUB_BOLDTICK_URL=https://boldtick.ishansahoo.com
# HUB_BOLDTICK_LOCAL_URL=http://localhost:3100
# HUB_TRADEFORGE_URL=https://www.ishansahoo.com
# HUB_TRADEFORGE_LOCAL_URL=http://localhost:3000
# Owner-only — these mint live Schwab credentials on TradeForge.
# HUB_AUTH_URL=https://www.ishansahoo.com/auth/trading
# HUB_MARKETDATA_URL=https://www.ishansahoo.com/auth/marketdata
